# Copy this file to data-generator/.env (or set DATA_GENERATOR_ENV_FILE to this path)

# Database connection (Docker default)
POSTGRES_HOST=banking-postgres
POSTGRES_PORT=5432
POSTGRES_DB=banking
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Generator profile tuned for BP1/BP2/BP3 dashboard signal
GEN_NUM_CUSTOMERS=120
GEN_ACCOUNTS_PER_CUSTOMER=2
GEN_NUM_TRANSACTIONS=1200
GEN_MAX_TXN_AMOUNT=2500
GEN_CURRENCY=USD

# BP1: transaction reliability / risk
GEN_FAILED_TX_RATIO=0.10
GEN_PENDING_TX_RATIO=0.05

# BP2: customer value and churn risk
GEN_DORMANT_CUSTOMER_RATIO=0.30

# BP3: liquidity risk distribution
GEN_LOW_BALANCE_ACCOUNT_RATIO=0.35
GEN_NO_RECENT_ACTIVITY_ACCOUNT_RATIO=0.25
GEN_ALLOW_OVERDRAWN=true
GEN_OVERDRAWN_ACCOUNT_RATIO=0.12
GEN_OVERDRAWN_MIN_ABS=50
GEN_OVERDRAWN_MAX_ABS=1200
